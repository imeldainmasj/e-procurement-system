// SIPITA — Prisma schema (IT SAPM procurement records & work tracking)
// Conventions (CLAUDE.md §6): UUID ids, createdAt/updatedAt, PascalCase models
// mapped to snake_case tables, money as Decimal(18,2), soft delete via deletedAt.
//
// Procurement data tables also carry createdById / updatedById (plain user ids, no FK,
// so users can be soft-deleted freely) and importBatchId (the import that produced the
// row, used by rollback).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums (keep in sync with shared/src/enums.ts) ───────────────────────────

enum JobLevel {
  STAFF
  MANAGER_L1
  MANAGER_L2
}

enum Feature {
  DASHBOARD
  WORK
  MONITORING
  AGREEMENT
  VENDOR
  REPORT
  IMPORT
  SETTINGS
}

enum ProcurementType {
  RENEWAL_LICENSE
  NEW_LICENSE
  NEW_APPLICATION
}

enum ProjectCategory {
  BAU
  PROJECT
}

enum ProcurementMethod {
  TENDER
  BIDDING
  SPECIAL_EXTENSION
  DIRECT_APPOINTMENT
}

enum RfqMethod {
  TENDER
  BIDDING
}

enum MemoType {
  MEMO_PROCUREMENT
  MEMO_PL
  MEMO_PK
  MOA_TENDER_RESULT
  MOA_PL
  MOA_PK
  MOA_COST
}

enum MilestoneType {
  MEMO
  RFQ
  PVP
  OFFICIAL_APPROVAL
  MOA_METHOD
  MOA_COST
  LOA
  PO
  AGREEMENT
  AGREEMENT_OR_ADDENDUM
}

enum Executor {
  IT
  OTHER_TEAM
  DIRECTORS
  OFFICIAL
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  NOT_APPLICABLE
}

enum WorkStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PkResult {
  ADDENDUM
  NEW_AGREEMENT
}

enum PvpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PvpDecision {
  APPROVED
  REJECTED
}

enum PoType {
  NEW
  RENEWAL
}

enum AgreementType {
  NEW
  RENEWAL
}

enum AgreementStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  ROLLED_BACK
  FAILED
}

enum IssueLevel {
  ERROR
  WARNING
}

enum AuditSource {
  APP
  IMPORT
}

// ─── Sistem ──────────────────────────────────────────────────────────────────

/// Counter for the work code WRK-{YYYY}-{NNNN} (counter per procurement year).
/// Locked with SELECT ... FOR UPDATE inside a transaction when incremented.
model DocumentSequence {
  id         String   @id @default(uuid()) @db.Uuid
  prefix     String
  year       Int
  lastNumber Int      @default(0) @map("last_number")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([prefix, year])
  @@map("document_sequences")
}

/// Thresholds and configuration (CLAUDE.md §5.6); one row per key.
model AppSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  action        String
  entity        String
  entityId      String      @map("entity_id")
  before        Json?
  after         Json?
  source        AuditSource @default(APP)
  /// Set when source = IMPORT, so a rollback can find the rows it touched.
  importBatchId String?     @map("import_batch_id") @db.Uuid
  ip            String?
  createdAt     DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([importBatchId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Machine-readable kind, e.g. CONTRACT_EXPIRING, STALE_WORK.
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  /// Keeps scheduled jobs idempotent, e.g. "STALE_WORK:<workId>:2026-10-25".
  dedupeKey String?   @unique @map("dedupe_key")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

/// Uploaded file. Stored under UPLOAD_DIR with a generated name and only served
/// through the authenticated download endpoint.
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  /// Original name as uploaded (for display and download).
  fileName     String   @map("file_name")
  /// Path relative to UPLOAD_DIR, e.g. 2026/10/<uuid>.pdf
  path         String   @unique
  mimeType     String   @map("mime_type")
  size         Int
  /// Owning record, e.g. refType "WorkUpdate"; decides who may download.
  refType      String?  @map("ref_type")
  refId        String?  @map("ref_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy  User         @relation(fields: [uploadedById], references: [id])
  workUpdates WorkUpdate[]

  @@index([refType, refId])
  @@map("attachments")
}

// ─── Organisasi & Auth ───────────────────────────────────────────────────────

model Directorate {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  divisions      Division[]
  requestedWorks Work[]

  @@map("directorates")
}

model Division {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  name          String
  directorateId String    @map("directorate_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  directorate Directorate  @relation(fields: [directorateId], references: [id])
  departments Department[]

  @@index([directorateId])
  @@map("divisions")
}

model Department {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique
  name       String
  divisionId String    @map("division_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  division Division @relation(fields: [divisionId], references: [id])
  users    User[]

  @@index([divisionId])
  @@map("departments")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @unique @map("employee_id")
  username     String    @unique
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  jobLevel     JobLevel  @default(STAFF) @map("job_level")
  departmentId String?   @map("department_id") @db.Uuid
  /// Separate from jobLevel: manages users, permissions, organisation, templates, settings, import rollback.
  isAdmin      Boolean   @default(false) @map("is_admin")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  permissions     UserPermission[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  attachments     Attachment[]
  updatedSettings AppSetting[]
  picWorks        Work[]           @relation("WorkPic")
  workUpdates     WorkUpdate[]
  picAgreements   Agreement[]      @relation("AgreementPic")
  importBatches   ImportBatch[]

  @@index([departmentId])
  @@map("users")
}

/// Narrows (never widens) what the job level allows, per feature.
model UserPermission {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  feature   Feature
  canView   Boolean  @default(true) @map("can_view")
  canCreate Boolean  @default(false) @map("can_create")
  canUpdate Boolean  @default(false) @map("can_update")
  canDelete Boolean  @default(false) @map("can_delete")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@map("user_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the signed refresh JWT; the raw token is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Vendor {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  name          String
  address       String?
  picName       String?   @map("pic_name")
  /// Digits only (15 or 16).
  npwp          String?   @unique
  email         String?
  phone         String?
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedById   String?   @map("updated_by_id") @db.Uuid
  importBatchId String?   @map("import_batch_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  works      Work[]
  agreements Agreement[]

  @@index([importBatchId])
  @@map("vendors")
}

// ─── Pekerjaan & Progres ─────────────────────────────────────────────────────

/// One procurement = one Work. Every document hangs off it.
model Work {
  id                     String            @id @default(uuid()) @db.Uuid
  /// WRK-{YYYY}-{NNNN}, YYYY = procurementYear.
  code                   String            @unique
  title                  String
  procurementType        ProcurementType   @map("procurement_type")
  category               ProjectCategory
  method                 ProcurementMethod
  procurementYear        Int               @map("procurement_year")
  picId                  String            @map("pic_id") @db.Uuid
  requesterDirectorateId String?           @map("requester_directorate_id") @db.Uuid
  vendorId               String?           @map("vendor_id") @db.Uuid
  amount                 Decimal           @db.Decimal(18, 2)
  currency               String            @default("IDR") @db.Char(3)
  exchangeRate           Decimal           @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  amountIdr              Decimal           @map("amount_idr") @db.Decimal(18, 2)
  /// Last year's purchase value in IDR; null for new procurements.
  previousPurchaseAmount Decimal?          @map("previous_purchase_amount") @db.Decimal(18, 2)
  /// Computed by the service from amountIdr and previousPurchaseAmount.
  increasePercent        Decimal?          @map("increase_percent") @db.Decimal(7, 2)
  /// Computed by the service (CLAUDE.md §5.3), never user input.
  pvpRequired            Boolean           @default(false) @map("pvp_required")
  periodStart            DateTime?         @map("period_start") @db.Date
  periodEnd              DateTime?         @map("period_end") @db.Date
  /// Required for SPECIAL_EXTENSION: the active contract being extended.
  sourceAgreementId      String?           @map("source_agreement_id") @db.Uuid
  pkResult               PkResult?         @map("pk_result")
  status                 WorkStatus        @default(ACTIVE)
  lastUpdatedAt          DateTime          @default(now()) @map("last_updated_at")
  /// Cached `getDataIssues` result ({ code, message }[]), refreshed on every change to the
  /// work, its milestones or documents, and when thresholds change. Staleness is not
  /// cached; it is derived from lastUpdatedAt at query time.
  dataIssues             Json              @default("[]") @map("data_issues")
  hasDataIssues          Boolean           @default(false) @map("has_data_issues")
  notes                  String?
  createdById            String?           @map("created_by_id") @db.Uuid
  updatedById            String?           @map("updated_by_id") @db.Uuid
  importBatchId          String?           @map("import_batch_id") @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  deletedAt              DateTime?         @map("deleted_at")

  pic                  User            @relation("WorkPic", fields: [picId], references: [id])
  requesterDirectorate Directorate?    @relation(fields: [requesterDirectorateId], references: [id], onDelete: SetNull)
  vendor               Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  sourceAgreement      Agreement?      @relation("SourceAgreement", fields: [sourceAgreementId], references: [id], onDelete: SetNull)
  importBatch          ImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  milestones           WorkMilestone[]
  updates              WorkUpdate[]
  memos                Memo[]
  rfq                  Rfq?
  pvpForum             PvpForum?
  purchaseOrders       PurchaseOrder[]
  agreements           Agreement[]     @relation("WorkAgreements")
  addendums            Addendum[]

  @@index([picId])
  @@index([procurementYear])
  @@index([method])
  @@index([status])
  @@index([vendorId])
  @@index([importBatchId])
  @@map("works")
}

model WorkMilestone {
  id            String          @id @default(uuid()) @db.Uuid
  workId        String          @map("work_id") @db.Uuid
  type          MilestoneType
  sequence      Int
  executor      Executor
  status        MilestoneStatus @default(NOT_STARTED)
  /// true = only applies when PVP is required (PVP*).
  isConditional Boolean         @default(false) @map("is_conditional")
  prerequisites MilestoneType[]
  startedAt     DateTime?       @map("started_at")
  completedAt   DateTime?       @map("completed_at")
  referenceNo   String?         @map("reference_no")
  notes         String?
  updatedById   String?         @map("updated_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  work    Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  updates WorkUpdate[]

  @@unique([workId, type])
  @@map("work_milestones")
}

/// Progress log. Append-only: corrections are written as a new update.
model WorkUpdate {
  id           String           @id @default(uuid()) @db.Uuid
  workId       String           @map("work_id") @db.Uuid
  milestoneId  String?          @map("milestone_id") @db.Uuid
  authorId     String           @map("author_id") @db.Uuid
  note         String
  statusFrom   MilestoneStatus? @map("status_from")
  statusTo     MilestoneStatus? @map("status_to")
  attachmentId String?          @map("attachment_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  work       Work           @relation(fields: [workId], references: [id], onDelete: Cascade)
  milestone  WorkMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  author     User           @relation(fields: [authorId], references: [id])
  attachment Attachment?    @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([workId, createdAt])
  @@index([authorId])
  @@map("work_updates")
}

/// Milestones created for new works of a method; editing it never touches existing works.
model MilestoneTemplate {
  id            String            @id @default(uuid()) @db.Uuid
  method        ProcurementMethod
  type          MilestoneType
  sequence      Int
  executor      Executor
  prerequisites MilestoneType[]
  isConditional Boolean           @default(false) @map("is_conditional")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@unique([method, type])
  @@map("milestone_templates")
}

// ─── Dokumen Pengadaan ───────────────────────────────────────────────────────

/// Procurement memos and every kind of MoA.
model Memo {
  id            String    @id @default(uuid()) @db.Uuid
  workId        String    @map("work_id") @db.Uuid
  memoNo        String    @unique @map("memo_no")
  memoType      MemoType  @map("memo_type")
  title         String
  memoDate      DateTime  @map("memo_date") @db.Date
  requesterName String?   @map("requester_name")
  amount        Decimal?  @db.Decimal(18, 2)
  currency      String?   @db.Char(3)
  exchangeRate  Decimal?  @map("exchange_rate") @db.Decimal(18, 6)
  amountIdr     Decimal?  @map("amount_idr") @db.Decimal(18, 2)
  notes         String?
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedById   String?   @map("updated_by_id") @db.Uuid
  importBatchId String?   @map("import_batch_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  work Work @relation(fields: [workId], references: [id])

  @@index([workId])
  @@index([importBatchId])
  @@map("memos")
}

/// One RFQ per work; also carries the LoA processed by the team outside IT.
model Rfq {
  id             String    @id @default(uuid()) @db.Uuid
  workId         String    @unique @map("work_id") @db.Uuid
  rfqNo          String    @unique @map("rfq_no")
  method         RfqMethod
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  amount         Decimal   @db.Decimal(18, 2)
  currency       String    @default("IDR") @db.Char(3)
  exchangeRate   Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  amountIdr      Decimal   @map("amount_idr") @db.Decimal(18, 2)
  termOfPayment  String?   @map("term_of_payment")
  loaNo          String?   @unique @map("loa_no")
  loaDate        DateTime? @map("loa_date") @db.Date
  /// Name of the team outside IT that processed the LoA.
  loaProcessedBy String?   @map("loa_processed_by")
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  importBatchId  String?   @map("import_batch_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  work Work @relation(fields: [workId], references: [id])

  @@index([importBatchId])
  @@map("rfqs")
}

model PvpForum {
  id            String    @id @default(uuid()) @db.Uuid
  workId        String    @unique @map("work_id") @db.Uuid
  pvpDate       DateTime  @map("pvp_date") @db.Date
  status        PvpStatus @default(PENDING)
  notes         String?
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedById   String?   @map("updated_by_id") @db.Uuid
  importBatchId String?   @map("import_batch_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  work      Work          @relation(fields: [workId], references: [id])
  approvals PvpApproval[]

  @@index([importBatchId])
  @@map("pvp_forums")
}

/// A director's decision, recorded as text (directors are not SIPITA users).
model PvpApproval {
  id            String      @id @default(uuid()) @db.Uuid
  pvpForumId    String      @map("pvp_forum_id") @db.Uuid
  directorName  String      @map("director_name")
  decision      PvpDecision
  approvalDate  DateTime    @map("approval_date") @db.Date
  notes         String?
  createdById   String?     @map("created_by_id") @db.Uuid
  updatedById   String?     @map("updated_by_id") @db.Uuid
  importBatchId String?     @map("import_batch_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  pvpForum PvpForum @relation(fields: [pvpForumId], references: [id])

  @@index([pvpForumId])
  @@index([importBatchId])
  @@map("pvp_approvals")
}

model PurchaseOrder {
  id                 String    @id @default(uuid()) @db.Uuid
  workId             String    @map("work_id") @db.Uuid
  poNo               String    @unique @map("po_no")
  poType             PoType    @map("po_type")
  poName             String    @map("po_name")
  poDate             DateTime  @map("po_date") @db.Date
  amount             Decimal   @db.Decimal(18, 2)
  currency           String    @default("IDR") @db.Char(3)
  exchangeRate       Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  amountIdr          Decimal   @map("amount_idr") @db.Decimal(18, 2)
  requesterName      String?   @map("requester_name")
  /// Renewal source when it exists in SIPITA; otherwise only the number/amount are kept.
  previousPoId       String?   @map("previous_po_id") @db.Uuid
  previousPoNo       String?   @map("previous_po_no")
  previousPoAmount   Decimal?  @map("previous_po_amount") @db.Decimal(18, 2)
  previousPoCurrency String?   @map("previous_po_currency") @db.Char(3)
  createdById        String?   @map("created_by_id") @db.Uuid
  updatedById        String?   @map("updated_by_id") @db.Uuid
  importBatchId      String?   @map("import_batch_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  work         Work            @relation(fields: [workId], references: [id])
  previousPo   PurchaseOrder?  @relation("PoRenewal", fields: [previousPoId], references: [id], onDelete: SetNull)
  renewals     PurchaseOrder[] @relation("PoRenewal")
  paymentTerms PoPaymentTerm[]
  agreement    Agreement?
  addendums    Addendum[]

  @@index([workId])
  @@index([importBatchId])
  @@map("purchase_orders")
}

/// Term of payment; amounts are in the PO's currency.
model PoPaymentTerm {
  id            String    @id @default(uuid()) @db.Uuid
  poId          String    @map("po_id") @db.Uuid
  sequence      Int
  description   String
  percentage    Decimal?  @db.Decimal(5, 2)
  amount        Decimal   @db.Decimal(18, 2)
  dueDate       DateTime? @map("due_date") @db.Date
  isPaid        Boolean   @default(false) @map("is_paid")
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedById   String?   @map("updated_by_id") @db.Uuid
  importBatchId String?   @map("import_batch_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])

  @@unique([poId, sequence])
  @@index([importBatchId])
  @@map("po_payment_terms")
}

model Agreement {
  id            String          @id @default(uuid()) @db.Uuid
  agreementNo   String          @unique @map("agreement_no")
  agreementType AgreementType   @map("agreement_type")
  title         String
  vendorId      String          @map("vendor_id") @db.Uuid
  /// 1 agreement ↔ 1 PO.
  poId          String          @unique @map("po_id") @db.Uuid
  workId        String          @map("work_id") @db.Uuid
  picId         String          @map("pic_id") @db.Uuid
  periodStart   DateTime        @map("period_start") @db.Date
  periodEnd     DateTime        @map("period_end") @db.Date
  amount        Decimal         @db.Decimal(18, 2)
  currency      String          @default("IDR") @db.Char(3)
  exchangeRate  Decimal         @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  amountIdr     Decimal         @map("amount_idr") @db.Decimal(18, 2)
  /// Maintained by the daily job from periodEnd + CONTRACT_REMINDER_DAYS.
  status        AgreementStatus @default(ACTIVE)
  createdById   String?         @map("created_by_id") @db.Uuid
  updatedById   String?         @map("updated_by_id") @db.Uuid
  importBatchId String?         @map("import_batch_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  work          Work          @relation("WorkAgreements", fields: [workId], references: [id])
  pic           User          @relation("AgreementPic", fields: [picId], references: [id])
  addendums     Addendum[]
  /// PK works that extend this agreement.
  extensions    Work[]        @relation("SourceAgreement")

  @@index([vendorId])
  @@index([workId])
  @@index([periodEnd])
  @@index([status])
  @@index([importBatchId])
  @@map("agreements")
}

model Addendum {
  id             String    @id @default(uuid()) @db.Uuid
  agreementId    String    @map("agreement_id") @db.Uuid
  workId         String    @map("work_id") @db.Uuid
  addendumNo     String    @unique @map("addendum_no")
  title          String
  addendumDate   DateTime  @map("addendum_date") @db.Date
  newPeriodEnd   DateTime? @map("new_period_end") @db.Date
  valueChange    Decimal?  @map("value_change") @db.Decimal(18, 2)
  currency       String?   @db.Char(3)
  exchangeRate   Decimal?  @map("exchange_rate") @db.Decimal(18, 6)
  valueChangeIdr Decimal?  @map("value_change_idr") @db.Decimal(18, 2)
  poId           String?   @map("po_id") @db.Uuid
  notes          String?
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  importBatchId  String?   @map("import_batch_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  agreement     Agreement      @relation(fields: [agreementId], references: [id])
  work          Work           @relation(fields: [workId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)

  @@index([agreementId])
  @@index([workId])
  @@index([importBatchId])
  @@map("addendums")
}

// ─── Import ──────────────────────────────────────────────────────────────────

model ImportBatch {
  id           String       @id @default(uuid()) @db.Uuid
  fileName     String       @map("file_name")
  /// Stored upload, re-read on commit.
  filePath     String?      @map("file_path")
  uploadedById String       @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")
  status       ImportStatus @default(PREVIEW)
  totalRows    Int          @default(0) @map("total_rows")
  validRows    Int          @default(0) @map("valid_rows")
  warningRows  Int          @default(0) @map("warning_rows")
  errorRows    Int          @default(0) @map("error_rows")
  committedAt  DateTime?    @map("committed_at")
  rolledBackAt DateTime?    @map("rolled_back_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  uploadedBy User             @relation(fields: [uploadedById], references: [id])
  issues     ImportRowIssue[]
  works      Work[]

  @@index([uploadedAt])
  @@map("import_batches")
}

model ImportRowIssue {
  id        String     @id @default(uuid()) @db.Uuid
  batchId   String     @map("batch_id") @db.Uuid
  sheet     String
  rowNumber Int        @map("row_number")
  level     IssueLevel
  field     String?
  message   String
  createdAt DateTime   @default(now()) @map("created_at")

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, level])
  @@map("import_row_issues")
}
